__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
# Python build/dist dirs only — root-level. The TS CLI also has
# typescript/cli/lib/ but we specifically want that gitignored too;
# see below.
/dist/
/build/

typescript/cli/lib/
typescript/cli/*.tsbuildinfo

# npm
node_modules/

# Pebbles runtime state (config is tracked, db is not)
.pebbles/pebbles.db
.pebbles/events.jsonl

# exophial runtime state (config.yaml stays committed)
.exophial/*
!.exophial/config.yaml
.worktrees/
.claude/worktrees/
.scratch/
/rust/target/
rust/fixtures/*/*/target/
rust/fixtures/*/*/Cargo.lock
# The ASP303-determinism fixture is a multi-crate workspace, so its build
# artifacts sit one level shallower than the violating/satisfying pairs.
rust/fixtures/**/target/
rust/fixtures/**/Cargo.lock
