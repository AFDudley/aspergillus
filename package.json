{
  "name": "@afdudley/aspergillus",
  "version": "0.1.0-rc.3",
  "description": "NASA-grade code quality rules for TypeScript (ESLint/Prettier/tsconfig configs + aspergillus-ts CLI)",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFDudley/aspergillus.git"
  },
  "exports": {
    "./eslint-config": "./typescript/configs/eslint.config.js",
    "./eslint-rules": "./typescript/rules/index.js",
    "./errors": "./typescript/errors/index.js",
    "./layouts/*": "./typescript/layouts/*.js",
    "./tsconfig": "./typescript/configs/tsconfig.base.json",
    "./prettier-config": "./typescript/configs/prettier.config.cjs",
    "./pre-commit": "./typescript/configs/pre-commit-config.yaml"
  },
  "bin": {
    "aspergillus-ts": "./typescript/cli/lib/index.js"
  },
  "files": [
    "typescript/configs/**",
    "typescript/cli/lib/**",
    "typescript/cli/package.json",
    "typescript/rules/**",
    "!typescript/rules/**/*.test.js",
    "!typescript/rules/package.json",
    "typescript/errors/**",
    "!typescript/errors/**/*.test.js",
    "typescript/layouts/**",
    "!typescript/layouts/index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc -p typescript/cli/tsconfig.json && node -e \"require('fs').chmodSync('typescript/cli/lib/index.js', 0o755)\"",
    "test": "bun test typescript/rules typescript/layouts typescript/errors"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@okee-tech/eslint-plugin-neverthrow": "^1.0.0",
    "@types/node": ">=18",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-functional": "^9.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-boundaries": {
      "optional": true
    },
    "eslint-import-resolver-typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
